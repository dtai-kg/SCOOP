@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix transit: <http://vocab.org/transit/terms/> .
@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/ns##GIDMapping/shape> a sh:NodeShape ;
    sh:class transit:GID ;
    sh:nodeKind sh:IRI ;
    sh:pattern "#gid-.*" ;
    sh:property [ dcterms:description "An identifier for the operation on a tree." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:name "GID" ;
            sh:nodeKind sh:Literal ;
            sh:path transit:GID ],
        [ dcterms:description "The operation performed on the tree." ;
            sh:datatype xsd:string ;
            sh:name "trim_cycle" ;
            sh:nodeKind sh:Literal ;
            sh:path wgs84_pos:trim_cycle ],
        [ dcterms:description "The species of the tree." ;
            sh:datatype xsd:string ;
            sh:name "species" ;
            sh:nodeKind sh:Literal ;
            sh:path wgs84_pos:Species ],
        [ dcterms:description "The date of the operation that was performed." ;
            sh:datatype xsd:date ;
            sh:name "inventory_date" ;
            sh:nodeKind sh:Literal ;
            sh:path wgs84_pos:inventory_date ],
        [ dcterms:description "The street that the tree is on." ;
            sh:datatype xsd:string ;
            sh:name "on_street" ;
            sh:nodeKind sh:Literal ;
            sh:path wgs84_pos:onstreet ] ;
    sh:targetClass transit:GID .

