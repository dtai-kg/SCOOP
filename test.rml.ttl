@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix gn: <http://www.geonames.org/ontology#>.
@base <http://example.com/ns#>.

<#VenueMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "test.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$"
  ];

  rr:subjectMap [
    rr:template "http://loc.example.com/city/{first_name}";
    rr:class schema:Person
  ];

  rr:predicateObjectMap [
    rr:predicate schema:firstName;
    rr:objectMap [
      rml:reference "first_name"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate schema:address;
    rr:objectMap [
      rr:parentTriplesMap <#AddressMapping>
    ];
  ].


<#AddressMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "test.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$"
  ];

  rr:subjectMap [
    rr:template "http://loc.example.com/city/{address}";
    rr:class schema:Address
  ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:streetAddress;
    rr:objectMap [
      rml:reference "address.street_address"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:city;
    rr:objectMap [
      rml:reference "address.city"
    ]
  ].