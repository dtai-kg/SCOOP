@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix transit: <http://vocab.org/transit/terms/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@base <http://example.com/ns#>.

<#GIDMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "tree-ops.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "#gid-{GID}";
    rr:class transit:GID
  ];

  rr:predicateObjectMap [
    rr:predicate transit:GID;
    rr:objectMap [
      rml:reference "GID";
      rr:datatype xsd:string
      ]
    ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:onstreet;
    rr:objectMap [
      rml:reference "On Street"
    ]
    ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:Species;
    rr:objectMap [
      rml:reference "Species"
    ]
    ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:trim_cycle;
    rr:objectMap [
      rml:reference "Trim Cycle"
    ]
    ];

  rr:predicateObjectMap [
    rr:predicate wgs84_pos:inventory_date;
    rr:objectMap [
      rml:reference "Inventory Date"
    ]
  ].